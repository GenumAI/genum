{
  "name": "genum",
  "version": "1.12.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "author": "support@genum.ai",
  "scripts": {
    "dev:infra:up": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker-compose -f docker-compose.dev.yml down",
    "dev:infra:prune": "docker-compose -f docker-compose.dev.yml down -v",
    "dev:web": "pnpm --filter web dev",
    "dev:core": "pnpm --filter core dev",
    "prisma:generate": "pnpm --filter core db:generate",
    "prisma:migrate": "pnpm --filter core db:migrate:dev",
    "prisma:studio": "pnpm --filter core db:studio",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "lint:staged": "lint-staged",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@eslint/js": "^9.39.5",
    "@release-it/bumper": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "lefthook": "^2.2.1",
    "lint-staged": "^17.6.0",
    "release-it": "^21.1.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "mysql2": "^3.23.1"
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "pushArgs": [
        "--no-verify"
      ]
    },
    "plugins": {
      "@release-it/bumper": {
        "out": [
          {
            "file": "./apps/web/package.json"
          },
          {
            "file": "./apps/core/package.json"
          },
          {
            "file": "./apps/web/src/constants/VERSION.ts",
            "type": "application/typescript"
          },
          {
            "file": "./apps/core/src/constants/VERSION.ts",
            "type": "application/typescript"
          }
        ]
      }
    },
    "github": {
      "release": true,
      "web": false,
      "draft": true,
      "releaseName": "v${version}",
      "comments": {
        "submit": true,
        "issue": ":rocket: _This issue has been resolved in v${version}. See [${releaseName}](${releaseUrl}) for release notes._",
        "pr": ":rocket: _This pull request is included in v${version}. See [${releaseName}](${releaseUrl}) for release notes._"
      }
    }
  }
}
