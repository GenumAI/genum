{
  "name": "genum",
  "version": "1.8.0",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "author": "support@genum.ai",
  "scripts": {
    "dev:infra:up": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker-compose -f docker-compose.dev.yml down",
    "dev:infra:prune": "docker-compose -f docker-compose.dev.yml down -v",
    "dev:web": "pnpm --filter web dev",
    "dev:core": "pnpm --filter core dev",
    "prisma:generate": "pnpm --filter core db:generate",
    "prisma:migrate": "pnpm --filter core db:migrate:dev",
    "prisma:studio": "pnpm --filter core db:studio",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "lint:staged": "lint-staged",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@eslint/js": "^9.39.4",
    "@release-it/bumper": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lefthook": "^2.0.9",
    "lint-staged": "^17.0.4",
    "release-it": "^20.0.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.6.5",
      "path-to-regexp": "^8.4.0",
      "qs": "^6.15.2",
      "jws": "4.0.1",
      "undici": "^7.28.0",
      "@hono/node-server": "^2.0.5",
      "hono": "^4.12.27",
      "lodash-es": "^4.18.0",
      "basic-ftp": "^5.3.1",
      "ip-address": "^10.1.1",
      "markdown-it": "^14.2.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@>=3": "^5.0.8",
      "fast-uri": "^3.1.4",
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.0",
      "linkify-it": "^5.0.2",
      "body-parser": "^2.3.0",
      "@babel/core": "^7.29.6",
      "@opentelemetry/core": "^2.8.0",
      "ws": "^8.21.0",
      "valibot": "^1.4.2",
      "uuid@<11.1.1": "^11.1.1"
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "pushArgs": [
        "--no-verify"
      ]
    },
    "plugins": {
      "@release-it/bumper": {
        "out": [
          {
            "file": "./apps/web/package.json"
          },
          {
            "file": "./apps/core/package.json"
          },
          {
            "file": "./apps/web/src/constants/VERSION.ts",
            "type": "application/typescript"
          },
          {
            "file": "./apps/core/src/constants/VERSION.ts",
            "type": "application/typescript"
          }
        ]
      }
    },
    "github": {
      "release": true,
      "web": true,
      "autoGenerate": true,
      "releaseName": "v${version}",
      "comments": {
        "submit": true,
        "issue": ":rocket: _This issue has been resolved in v${version}. See [${releaseName}](${releaseUrl}) for release notes._",
        "pr": ":rocket: _This pull request is included in v${version}. See [${releaseName}](${releaseUrl}) for release notes._"
      }
    }
  }
}
