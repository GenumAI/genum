enum AssertionType {
    STRICT
    AI
    MANUAL
}

// How a prompt's rendered instruction is shaped before it reaches the model.
//
// XML is what every prompt has always got: markdown headers become tags, lines are
// XML-escaped, blank and `---` lines are dropped, and the result is wrapped in
// <instructions> (see utils/xml.ts). RAW sends the rendered text as written.
//
// The default is XML because changing the shape of an existing prompt's instruction
// changes what its model sees, and therefore what it answers -- silently, for every
// prompt at once. RAW exists for an author who wants the model to read their markdown as
// markdown, and for a caller whose own agent loop sends the raw text: without it, that
// caller's production traffic and a Lab replay of it run differently shaped instructions.
enum InstructionFormat {
    XML
    RAW
}

model Prompt {
    id                  Int           @id @default(autoincrement())
    value               String
    languageModelId     Int           @default(1)
    languageModel       LanguageModel @relation(fields: [languageModelId], references: [id])
    name                String        @db.VarChar(255)
    languageModelConfig Json          @default("{}")

    assertionType  AssertionType @default(STRICT)
    assertionValue String?       @default("")

    instructionFormat InstructionFormat @default(XML)

    commited Boolean @default(false)

    projectId Int
    project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @db.Timestamp(6)
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

    testCases    TestCase[]
    branches     Branch[]
    placeholders Placeholder[]
    chat         PromptChat[]
    audit        Audit?

    @@index([projectId])
}

model PromptChat {
    id        Int      @id @default(autoincrement())
    promptId  Int
    prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
    userId    Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    thread_id String?
    createdAt DateTime @default(now()) @db.Timestamp(6)
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

    messages PromptChatMessage[]

    @@unique([userId, promptId])
}

model PromptChatMessage {
    id           Int        @id @default(autoincrement())
    promptChatId Int
    promptChat   PromptChat @relation(fields: [promptChatId], references: [id], onDelete: Cascade)
    message      Json
    createdAt    DateTime   @default(now()) @db.Timestamp(6)
}

model Audit {
    id        Int      @id @default(autoincrement())
    promptId  Int
    prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
    data      Json
    createdAt DateTime @default(now()) @db.Timestamp(6)
    updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

    @@unique([promptId])
}

model Branch {
    id        Int      @id @default(autoincrement())
    promptId  Int
    prompt    Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
    name      String   @db.VarChar(255)
    createdAt DateTime @default(now()) @db.Timestamp(6)

    promptVersions PromptVersion[]

    @@unique([promptId, name]) // branch name is unique for each prompt
}

model PromptVersion {
    id Int @id @default(autoincrement())

    branchId Int
    branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

    commitHash String
    commitMsg  String
    value      String

    languageModelId     Int           @default(1)
    languageModel       LanguageModel @relation(fields: [languageModelId], references: [id])
    languageModelConfig Json          @default("{}")

    audit        Json?
    placeholders Json?

    authorId Int?
    author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())

    @@index([branchId])
}
