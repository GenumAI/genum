{
  "name": "core",
  "private": true,
  "version": "1.13.0",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:alias": "tsc-alias",
    "build:full": "pnpm run build && pnpm run build:alias",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "dotenv -e ../../.env tsx watch src/server.ts",
    "seed:dev": "tsx src/database/seed/seed.ts",
    "report:placeholder-migration": "dotenv -e ../../.env tsx src/database/seed/report-placeholder-migration.ts",
    "report:placeholder-migration:prod": "node dist/database/seed/report-placeholder-migration.js",
    "seed:prod": "node dist/database/seed/seed.js",
    "close-account": "node dist/erasure/close-account.js",
    "close-account:dev": "dotenv -e ../../.env tsx src/erasure/close-account.ts",
    "clickhouse:migrate:dev": "dotenv -e ../../.env tsx src/clickhouse/cli/migrate.ts",
    "clickhouse:migrate:prod": "node dist/clickhouse/cli/migrate.js",
    "clickhouse:status:dev": "dotenv -e ../../.env tsx src/clickhouse/cli/status.ts",
    "clickhouse:status:prod": "node dist/clickhouse/cli/status.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "dotenv -e ../../.env pnpm prisma migrate dev",
    "db:studio": "dotenv -e ../../.env prisma studio",
    "dev:db-init": "pnpm run db:generate && dotenv -e ../../.env prisma migrate dev && dotenv -e ../../.env pnpm run clickhouse:migrate:dev && dotenv -e ../../.env pnpm run seed:dev",
    "db-init": "prisma migrate deploy && pnpm run clickhouse:migrate:prod && pnpm run seed:prod",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@vitest/ui": "^4.1.11",
    "tsc-alias": "^1.9.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.58.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@clickhouse/client": "^1.24.0",
    "@genum/placeholders": "workspace:*",
    "@genum/steps": "workspace:*",
    "@google/genai": "^1.52.0",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/openai": "^1.6.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.76.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "express-rate-limit": "^8.7.1",
    "langchain": "^1.5.15",
    "moment": "^2.31.0",
    "multer": "^2.4.0",
    "openai": "^6.49.0",
    "prisma": "^7.10.0",
    "prisma-zod-generator": "^2.9.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  }
}
