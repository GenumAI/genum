# Stage 1: Builder - Compile TypeScript
# Pinned to the *build* platform: this stage emits only JavaScript (tsc output plus
# the generated Prisma client, which is engine-less under the `prisma-client`
# generator + driver adapters), so its output is architecture-independent. Its
# node_modules are never copied into the runtime stage -- that stage installs its
# own, so native modules (bcrypt) and the Prisma migration engine are still built
# for the target architecture.
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder

# Install openssl for Prisma
RUN apk add --no-cache openssl

# Enable corepack for pnpm support
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Set working directory
WORKDIR /app

# Copy root pnpm files (monorepo setup)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY scripts ./scripts

# Copy the workspace package manifests so --frozen-lockfile can resolve the
# apps/core "@genum/placeholders" and "@genum/steps": "workspace:*" links, then the
# app manifest.
COPY packages/placeholders/package.json ./packages/placeholders/
COPY packages/steps/package.json ./packages/steps/
COPY apps/core/package.json ./apps/core/

# Install all dependencies (including devDependencies for build)
# Use --filter to install only core app dependencies
RUN DOCKER_BUILD=true pnpm install --frozen-lockfile --filter core

# Copy the workspace packages' source and build them (dual CJS/ESM output) before
# the app build, since apps/core (tsc + tsc-alias, no bundling) resolves each
# package's "require" condition through node_modules at both compile and run time.
COPY packages/placeholders/ ./packages/placeholders/
RUN pnpm --filter @genum/placeholders run build
COPY packages/steps/ ./packages/steps/
RUN pnpm --filter @genum/steps run build

# Copy source code and configuration files
COPY apps/core/ ./apps/core/

# Generate Prisma client and build
WORKDIR /app/apps/core
RUN pnpm exec prisma generate
RUN pnpm run build:full
WORKDIR /app

# Stage 2: Dist - artifact-only stage used by CI to pull the compiled output out of
# the image (`--target dist`) for the Sentry source map upload. This is the same
# `build:full` output that actually ships, unlike a separate `build` run on the
# runner. Kept before the runtime stage so `runtime` stays last.
FROM scratch AS dist
COPY --from=builder /app/apps/core/dist /

# Stage 3: Runtime - Production image
FROM node:22-alpine AS runtime

# Install openssl for Prisma
RUN apk add --no-cache openssl

# Enable corepack for pnpm support
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Set working directory
WORKDIR /app

# Copy root pnpm files (monorepo setup)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY scripts ./scripts

# Copy the workspace package manifests so --frozen-lockfile can resolve the
# apps/core "@genum/placeholders" and "@genum/steps": "workspace:*" links, then the
# app manifest.
COPY packages/placeholders/package.json ./packages/placeholders/
COPY packages/steps/package.json ./packages/steps/
COPY apps/core/package.json ./apps/core/

# Install only production dependencies
RUN DOCKER_BUILD=true pnpm install --frozen-lockfile --prod --filter core

# apps/core is not bundled (tsc + tsc-alias), so its compiled `require("@genum/
# placeholders")` and `require("@genum/steps")` resolve through node_modules -> the
# pnpm workspace symlinks -> packages/* at runtime. The install above only linked the
# manifests copied above; bring in each built dist (produced in the builder stage) so
# those symlink targets actually have something to resolve.
COPY --from=builder /app/packages/placeholders/dist ./packages/placeholders/dist
COPY --from=builder /app/packages/steps/dist ./packages/steps/dist

# Copy compiled JavaScript from builder stage
COPY --from=builder /app/apps/core/dist ./apps/core/dist
COPY --from=builder /app/apps/core/docker-entrypoint.sh ./apps/core/docker-entrypoint.sh

COPY --from=builder /app/apps/core/src/ai ./apps/core/src/ai

# Copy Prisma schema, config and generated client
COPY --from=builder /app/apps/core/prisma ./apps/core/prisma
COPY --from=builder /app/apps/core/prisma.config.ts ./apps/core/prisma.config.ts
COPY --from=builder /app/apps/core/clickhouse ./apps/core/clickhouse

# Set working directory to core app
WORKDIR /app/apps/core

# Set NODE_ENV to production by default (can be overridden in docker-compose)
ENV NODE_ENV=production

RUN chmod +x ./docker-entrypoint.sh

# Expose port
EXPOSE 3010

# Run migrations + seed, then start the server
ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["node", "dist/server.js"]
