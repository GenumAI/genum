{
	"files": {
		"includes": [
			"**/*",
			"!.turbo",
			"!**/.turbo",
			"!.generated",
			"!**/.generated",
			// Claude Code worktrees are nested checkouts; their biome.jsonc
			// would abort the run with "Found a nested root configuration".
			// Keep this as "!.claude" — "!**/.claude" ignores the whole repo.
			"!.claude",
			"!dist",
			"!**/dist",
			"!**/package.json",
			"!**/pnpm-lock.yaml",
			"!**/*.test.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				// "noExplicitAny": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
